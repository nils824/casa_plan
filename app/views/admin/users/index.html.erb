<% content_for :title, "Benutzerverwaltung – CasaPlan" %>

<h1 class="page-title">Benutzerverwaltung</h1>

<div class="card">
  <table class="table">
    <thead>
      <tr><th>Name</th><th>E-Mail-Adresse</th><th>Rolle</th><th></th></tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr id="<%= dom_id(user) %>">
          <td><%= user.name %></td>
          <td><%= user.email_address %></td>
          <td><%= user.role_label %></td>
          <td><%= link_to "Bearbeiten", edit_admin_user_path(user), class: "link" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
