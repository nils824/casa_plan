<% content_for :title, "Benutzer bearbeiten – CasaPlan" %>

<h1 class="page-title">Benutzer bearbeiten</h1>

<%= render "shared/errors", record: @user %>

<div class="card max-w-lg">
  <%= form_with model: @user, url: admin_user_path(@user) do |f| %>
    <div class="field">
      <%= f.label :name, class: "label" %>
      <%= f.text_field :name, required: true, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :email_address, class: "label" %>
      <%= f.email_field :email_address, required: true, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :role, class: "label" %>
      <% if policy(@user).permitted_attributes.include?(:role) %>
        <%= f.select :role, User.roles.keys.map { |role| [ I18n.t(role, scope: "user_roles"), role ] }, {}, class: "input" %>
      <% else %>
        <p class="mt-1"><%= @user.role_label %> <span class="text-sm text-stone-500">(die eigene Rolle kann nicht geändert werden)</span></p>
      <% end %>
    </div>
    <div class="flex gap-3">
      <%= f.submit "Speichern", class: "btn-primary" %>
      <%= link_to "Abbrechen", admin_users_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
