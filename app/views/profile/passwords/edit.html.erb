<% content_for :title, "Passwort ändern – CasaPlan" %>

<h1 class="page-title">Passwort ändern</h1>

<%= render "shared/errors", record: @user %>

<div class="card max-w-lg">
  <%= form_with model: @user, url: profile_password_path, method: :patch do |f| %>
    <div class="field">
      <%= f.label :password_challenge, class: "label" %>
      <%= f.password_field :password_challenge, required: true, autocomplete: "current-password", class: "input" %>
    </div>
    <div class="field">
      <%= f.label :password, "Neues Passwort (mind. 12 Zeichen)", class: "label" %>
      <%= f.password_field :password, required: true, minlength: 12, maxlength: 72,
                           autocomplete: "new-password", class: "input" %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "Neues Passwort bestätigen", class: "label" %>
      <%= f.password_field :password_confirmation, required: true, maxlength: 72,
                           autocomplete: "new-password", class: "input" %>
    </div>
    <p class="mb-4 text-sm text-stone-500">Nach der Änderung werden alle anderen Sitzungen abgemeldet.</p>
    <div class="flex gap-3">
      <%= f.submit "Passwort ändern", class: "btn-primary" %>
      <%= link_to "Abbrechen", profile_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
