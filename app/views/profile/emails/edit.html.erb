<% content_for :title, "E-Mail-Adresse ändern – CasaPlan" %>

<h1 class="page-title">E-Mail-Adresse ändern</h1>

<p class="mb-4">Aktuelle Adresse: <strong><%= @user.email_address %></strong></p>

<%= render "shared/errors", record: @user %>

<div class="card max-w-lg">
  <%= form_with model: @user, url: profile_email_path, method: :patch do |f| %>
    <div class="field">
      <%= f.label :unconfirmed_email, class: "label" %>
      <%= f.email_field :unconfirmed_email, required: true, class: "input" %>
    </div>
    <p class="mb-4 text-sm text-stone-500">
      Du erhältst einen Bestätigungslink an die neue Adresse. Erst nach dem Klick darauf wird sie übernommen.
    </p>
    <div class="flex gap-3">
      <%= f.submit "Bestätigungslink senden", class: "btn-primary" %>
      <%= link_to "Abbrechen", profile_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
