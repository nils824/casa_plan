<% content_for :title, "Registrieren – CasaPlan" %>

<div class="max-w-md mx-auto">
  <h1 class="page-title">Registrieren</h1>

  <p class="mb-4 text-stone-600">
    Für die Registrierung brauchst du den Einladungscode, den du vom Verwalter erhalten hast.
  </p>

  <%= render "shared/errors", record: @user %>

  <div class="card">
    <%= form_with model: @user, url: registration_path do |f| %>
      <div class="field">
        <%= f.label :name, class: "label" %>
        <%= f.text_field :name, required: true, class: "input" %>
      </div>
      <div class="field">
        <%= f.label :email_address, class: "label" %>
        <%= f.email_field :email_address, required: true, autocomplete: "email", class: "input" %>
      </div>
      <div class="field">
        <%= f.label :password, "Passwort (mind. 12 Zeichen)", class: "label" %>
        <%= f.password_field :password, required: true, minlength: 12, maxlength: 72,
                             autocomplete: "new-password", class: "input" %>
      </div>
      <div class="field">
        <%= f.label :password_confirmation, class: "label" %>
        <%= f.password_field :password_confirmation, required: true, maxlength: 72,
                             autocomplete: "new-password", class: "input" %>
      </div>
      <div class="field">
        <%= label_tag "user[invitation_code]", "Einladungscode", class: "label" %>
        <%= text_field_tag "user[invitation_code]", params.dig(:user, :invitation_code), required: true, class: "input" %>
      </div>
      <%= f.submit "Registrieren", class: "btn-primary" %>
    <% end %>
  </div>

  <p>Bereits registriert? <%= link_to "Anmelden", new_session_path, class: "link" %></p>
</div>
