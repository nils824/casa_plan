<% content_for :title, "Neues Passwort – CasaPlan" %>

<div class="max-w-md mx-auto">
  <h1 class="page-title">Neues Passwort festlegen</h1>

  <div class="card">
    <%= form_with url: password_path(params[:token]), method: :put do |form| %>
      <div class="field">
        <%= form.label :password, "Neues Passwort (mind. 12 Zeichen)", class: "label" %>
        <%= form.password_field :password, required: true, minlength: 12, maxlength: 72,
                                autocomplete: "new-password", class: "input" %>
      </div>

      <div class="field">
        <%= form.label :password_confirmation, "Neues Passwort bestätigen", class: "label" %>
        <%= form.password_field :password_confirmation, required: true, maxlength: 72,
                                autocomplete: "new-password", class: "input" %>
      </div>

      <%= form.submit "Speichern", class: "btn-primary" %>
    <% end %>
  </div>
</div>
