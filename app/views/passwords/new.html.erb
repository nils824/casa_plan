<% content_for :title, "Passwort vergessen – CasaPlan" %>

<div class="max-w-md mx-auto">
  <h1 class="page-title">Passwort vergessen?</h1>

  <div class="card">
    <%= form_with url: passwords_path do |form| %>
      <div class="field">
        <%= form.label :email_address, "E-Mail-Adresse", class: "label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                             value: params[:email_address], class: "input" %>
      </div>

      <%= form.submit "Anleitung senden", class: "btn-primary" %>
    <% end %>
  </div>

  <%= link_to "Zurück zur Anmeldung", new_session_path, class: "link" %>
</div>
