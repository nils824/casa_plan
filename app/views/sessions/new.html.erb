<% content_for :title, "Anmelden – CasaPlan" %>

<div class="max-w-md mx-auto">
  <h1 class="page-title">Anmelden</h1>

  <div class="card">
    <%= form_with url: session_url do |form| %>
      <div class="field">
        <%= form.label :email_address, "E-Mail-Adresse", class: "label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                             value: params[:email_address], class: "input" %>
      </div>

      <div class="field">
        <%= form.label :password, "Passwort", class: "label" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
      </div>

      <div class="flex items-center gap-4">
        <%= form.submit "Anmelden", class: "btn-primary" %>
        <%= link_to "Passwort vergessen?", new_password_path, class: "link text-sm" %>
      </div>
    <% end %>
  </div>

  <p>Noch kein Konto? <%= link_to "Mit Einladungscode registrieren", new_registration_path, class: "link" %></p>
</div>
