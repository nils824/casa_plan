<% content_for :title, "Name ändern – CasaPlan" %>

<h1 class="page-title">Name ändern</h1>

<%= render "shared/errors", record: @user %>

<div class="card max-w-lg">
  <%= form_with model: @user, url: profile_path, method: :patch do |f| %>
    <div class="field">
      <%= f.label :name, class: "label" %>
      <%= f.text_field :name, required: true, class: "input" %>
    </div>
    <div class="flex gap-3">
      <%= f.submit "Speichern", class: "btn-primary" %>
      <%= link_to "Abbrechen", profile_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
